{
  "name": "@upload-media/client",
  "version": "1.0.0",
  "description": "Framework-agnostic chunk and direct file upload client library",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/upload.worker.d.ts",
      "import": "./dist/worker/upload.worker.mjs",
      "require": "./dist/worker/upload.worker.js"
    }
  },
  "homepage": "https://github.com/VictorAjadi/upload-media",
  "repository": {
    "type": "git",
    "url": "https://github.com/VictorAjadi/upload-media"
  },
  "keywords": [
    "upload-media",
    "file-upload",
    "media-upload"
  ],
  "author": "Victor Ajadi",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:main && npm run build:worker",
    "build:main": "tsup src/index.ts --format cjs,esm --dts --shims --splitting false --out-dir dist",
    "build:worker": "tsup src/worker/upload.worker.ts --format cjs,esm --dts --shims --splitting false --out-dir dist/worker",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:worker\"",
    "dev:main": "tsup src/index.ts --format cjs,esm --dts --watch --shims --out-dir dist",
    "dev:worker": "tsup src/worker/upload.worker.ts --format cjs,esm --dts --watch --shims --out-dir dist/worker"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.6",
    "@ffmpeg/util": "^0.12.1",
    "immer": "^10.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}